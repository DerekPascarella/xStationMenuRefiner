<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="xStationMenuRefiner.App.Views.UpdateWizardWindow"
        Title="Updating xStation Menu Refiner" Width="470" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://xStationMenuRefiner/Assets/xstation_icon.ico">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ProgressBar x:Name="DownloadBar" Height="22" Minimum="0" Maximum="100"/>

        <TextBlock x:Name="SpeedText" Margin="0,8,0,0" Foreground="Gray"/>
        <TextBlock x:Name="SizeText" Margin="0,4,0,0" Foreground="Gray"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelDownloadButton" Content="Cancel" Click="CancelDownloadButton_Click"
                    MinWidth="90" Margin="0,0,8,0" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Abort the download and close"/>
            <Button x:Name="InstallButton" Content="Install Now" Click="InstallButton_Click"
                    MinWidth="100" HorizontalContentAlignment="Center" IsVisible="False"
                    ToolTip.Tip="Install the downloaded update and restart"/>
        </StackPanel>
    </StackPanel>
</Window>
