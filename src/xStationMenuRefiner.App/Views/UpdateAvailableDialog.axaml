<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="xStationMenuRefiner.App.Views.UpdateAvailableDialog"
        Title="Update Available" Width="470" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://xStationMenuRefiner/Assets/xstation_icon.ico">
    <Grid RowDefinitions="Auto,Auto" Margin="16,14">
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="A new version of xStation Menu Refiner ("/>
                <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                <TextBlock Text=") is available."/>
            </StackPanel>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Would you like to update now? Your settings will be preserved."/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="See the "/>
                <TextBlock Foreground="#326DB3" TextDecorations="Underline" Cursor="Hand"
                           ToolTip.Tip="Open the changelog in your browser"
                           PointerPressed="ChangelogLink_PointerPressed"
                           Text="changelog"/>
                <TextBlock Text=" for what is new in this release."/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="Skip This Version" Click="SkipButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,0,4,0"
                    ToolTip.Tip="Stop notifying me about this version"/>
            <Button Grid.Column="1" Content="Update Later" Click="RemindButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="4,0,4,0"
                    ToolTip.Tip="Dismiss for now and check again next launch"/>
            <Button Grid.Column="2" Content="Update Now" Click="UpdateButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="4,0,0,0" IsDefault="True"
                    ToolTip.Tip="Download and install this update now"/>
        </Grid>
    </Grid>
</Window>
