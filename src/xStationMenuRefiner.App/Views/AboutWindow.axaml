<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="xStationMenuRefiner.App.Views.AboutWindow"
        Title="About" Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://xStationMenuRefiner/Assets/xstation_icon.ico">
    <Grid ColumnDefinitions="Auto,*" Margin="16,14">
        <Image Grid.Column="0" Width="132" VerticalAlignment="Top" Margin="0,2,18,0"
               Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="avares://xStationMenuRefiner/Assets/xstation_logo.png"/>
        <StackPanel Grid.Column="1">
            <TextBlock FontWeight="Bold" FontSize="16">
                <Run Text="xStation Menu Refiner"/>
                <Run x:Name="VersionRun"/>
            </TextBlock>
            <TextBlock Margin="0,4,0,0">by Derek Pascarella (ateam)</TextBlock>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="A utility for customizing how xStation will display game titles."/>
            <TextBlock Margin="0,10,0,0" x:Name="FormatsText" TextWrapping="Wrap"/>
            <TextBlock Margin="0,10,0,0">Documentation:</TextBlock>
            <TextBlock Margin="0,2,0,0" Foreground="#326DB3" TextDecorations="Underline"
                       Cursor="Hand" PointerPressed="LinkText_PointerPressed"
                       TextWrapping="Wrap"
                       ToolTip.Tip="Open the project page on GitHub"
                       Text="https://github.com/DerekPascarella/xStationMenuRefiner"/>
            <Button Content="Check for Updates" Click="CheckForUpdatesButton_Click"
                    Margin="0,15,0,0" HorizontalAlignment="Right"
                    ToolTip.Tip="Check GitHub for a newer release"/>
        </StackPanel>
    </Grid>
</Window>
